POSTGRES_DB=wedding
POSTGRES_USER=wedding_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://wedding_user:change-me@db:5432/wedding

# Required. Use ./scripts/rotate-secrets.sh to generate real values.
SECRET_KEY=generate-a-random-string-of-at-least-40-characters-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5201
# CSRF_TRUSTED_ORIGINS=https://wedding.example.com
# HTTPS_ONLY=True
# NUM_PROXIES=1

ADMIN_EMAIL=admin@wedding.local
ADMIN_PASSWORD=change-me

# Brevo SMTP (Settings -> SMTP & API). Without these, mails are only printed to the backend log.
# BREVO_SMTP_LOGIN=xxxxxx@smtp-brevo.com
# BREVO_SMTP_KEY=xsmtpsib-...
# EMAIL_FROM=Naša svadba <noreply@your-verified-domain.sk>
# SITE_URL=https://wedding.example.com
